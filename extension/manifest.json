{
  "manifest_version": 3,
  "name": "Gemini Enhancer",
  "version": "1.7.1",
  "description": "Ask follow-ups with native-feeling UI and robust slash commands on gemini.google.com.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Manage Slash Commands",
    "default_popup": "popup.html"
  }
}